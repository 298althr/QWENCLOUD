# ALTHR Autopilot — Environment Variables Template
# Copy to .env and fill in real values. Never commit the real .env.

# ---- Qwen Cloud (REQUIRED) ----
DASHSCOPE_API_KEY=sk-your-qwen-key-here
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_RESPONSES_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHATID=
TELEGRAM_ALLOWED_USERS=

# ---- Database (PostgreSQL) ----
# Used by docker-compose internally. Do not change unless you customize the Postgres container.
DATABASE_URL=postgresql://althr:althr@localhost:5432/althr_autopilot

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Email (Resend, optional) ----
RESEND_API_KEY=

# ---- GitHub (optional, used by deploy engine for private repos) ----
GITHUB_TOKEN=

# ---- Alibaba Cloud (optional, for ECS deployment) ----
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION=ap-southeast-1
ALIBABA_CLOUD_OSS_BUCKET=

# ---- Server ----
PORT=3000
CORS_ORIGIN=*
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ---- Production URL ----
# Set this to your ECS public IP or domain for production deployments.
# The frontend uses this to know where the backend API is.
# Examples: http://8.219.xxx.xxx  or  https://althr.example.com
PUBLIC_URL=http://localhost:3000

# ---- API Authentication ----
# Set this to require an x-api-key header on all non-public API endpoints.
# Leave empty to disable API key auth (not recommended for production).
ALTHR_API_KEY=

# ---- Agent config ----
AUTO_EXECUTE_THRESHOLD=0.85
MONITOR_INTERVAL_MS=30000

# ---- Incident escalation (human-in-the-loop timeout) ----
# Time in ms before a pending human approval is automatically escalated.
ESCALATION_TIMEOUT_MS=600000
# Max auto-remediation attempts before escalating.
MAX_AUTO_RETRY=2

# ---- Root password (for container SSH, optional) ----
ROOT_PASSWORD=

# ---- Remote SSH Hosts (optional) ----
# Format: JSON array of host objects.
# Example:
# REMOTE_HOSTS=[{"id":"my-server","name":"My Server","host":"10.0.0.5","port":22,"user":"admin","privateKeyEnv":"MY_SERVER_KEY"}]
# MY_SERVER_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...key contents...
# -----END OPENSSH PRIVATE KEY-----"
REMOTE_HOSTS=
