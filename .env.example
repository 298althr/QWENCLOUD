# ALTHR Autopilot — Environment Variables Template
# Copy to .env and fill in real values. Never commit the real .env.

# ---- Qwen Cloud (REQUIRED) ----
DASHSCOPE_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_RESPONSES_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---- Database (PostgreSQL / Alibaba Cloud RDS) ----
DATABASE_URL=postgresql://althr:althr@localhost:5432/althr_autopilot

# ---- Redis (Alibaba Cloud Redis) ----
REDIS_URL=redis://localhost:6379

# ---- Email (Resend) ----
RESEND_API_KEY=

# ---- Alibaba Cloud (ECS / OSS / Cloud Monitor) ----
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION=us-west-1
ALIBABA_CLOUD_OSS_BUCKET=

# ---- Server ----
PORT=3000
CORS_ORIGIN=*
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ---- Agent config ----
AUTO_EXECUTE_THRESHOLD=0.85
MONITOR_INTERVAL_MS=30000
