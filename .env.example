# ALTHR Autopilot — Environment Variables Template
# Copy to .env and fill in real values. Never commit the real .env.

# ---- Qwen Cloud (REQUIRED) ----
DASHSCOPE_API_KEY=sk-your-qwen-key-here
# Chat Completions, Responses, and Embeddings all use the same base URL.
# The legacy /api/v2/apps/protocols/ path is deprecated — do not use it.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_RESPONSES_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---- Database (PostgreSQL / Alibaba Cloud RDS) ----
DATABASE_URL=postgresql://althr:althr@localhost:5432/althr_autopilot

# ---- Redis (Alibaba Cloud Redis) ----
REDIS_URL=redis://localhost:6379

# ---- Email (Resend) ----
RESEND_API_KEY=

# ---- GitHub (optional but recommended for deploy reliability) ----
GITHUB_TOKEN=

# ---- Alibaba Cloud (ECS / OSS / Cloud Monitor) ----
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION=ap-southeast-1
ALIBABA_CLOUD_OSS_BUCKET=

# ---- Server ----
PORT=3000
CORS_ORIGIN=*
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ---- Production URL (for docker-compose.prod.yml frontend build arg) ----
# Set this to your ECS public IP or domain, e.g., http://8.219.xxx.xxx
PUBLIC_URL=http://localhost:3000

# ---- Agent config ----
AUTO_EXECUTE_THRESHOLD=0.85
MONITOR_INTERVAL_MS=30000

# ---- Remote SSH Hosts ----
# Configure any Linux host for SSH management via the ALTHR dashboard.
# Format: JSON array of host objects. Each host has:
#   id            — unique identifier used in API URLs
#   name          — display name shown in the UI
#   host          — IP address or hostname of the remote machine
#   port          — SSH port (default 22)
#   user          — SSH username
#   privateKeyEnv — name of the env var containing the private key
#
# The private key must be an OpenSSH-format key stored in the env var
# referenced by privateKeyEnv. Generate with:
#   ssh-keygen -t ed25519 -f ~/.ssh/my_host_key -C "althr-remote"
#
# Example:
# REMOTE_HOSTS=[{"id":"my-server","name":"My Server","host":"10.0.0.5","port":22,"user":"admin","privateKeyEnv":"MY_SERVER_KEY"}]
# MY_SERVER_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...key contents...
# -----END OPENSSH PRIVATE KEY-----"
REMOTE_HOSTS=
